# ============================================================
# SmartStore 环境配置文件示例
# ============================================================
#
# 使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 修改下面的配置值为你的实际配置
# 3. .env 文件包含敏感信息，已在 .gitignore 中忽略
#
# 快速开始：
#   cp .env.example .env       (Linux/Mac)
#   copy .env.example .env     (Windows)
#
# ============================================================

# ==================== 数据库配置 ====================
# MySQL 数据库连接信息
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password-here    # ⚠️ 请修改为你的 MySQL 密码
DB_NAME=smartstore

# ==================== Flask 配置 ====================
# Flask 应用配置
FLASK_ENV=development                       # development 或 production
FLASK_DEBUG=True                           # 生产环境请设置为 False
SECRET_KEY=change-this-to-random-secret-key-in-production    # ⚠️ 生产环境请使用强随机密钥

# 服务器配置
HOST=0.0.0.0                               # 0.0.0.0 允许外部访问，127.0.0.1 仅本地
PORT=5000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO                             # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ==================== AI 模型配置 ====================
USE_GPU=False                              # 是否使用 GPU（需要 CUDA 环境）

# ==================== LLM API 配置（可选功能） ====================
# 如果需要使用 LLM 语音交互功能，请配置以下选项
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-3.5-turbo

# ==================== 其他配置 ====================
# 文件上传限制（MB）
MAX_UPLOAD_SIZE=16

# 人脸识别阈值（距离，越小越严格，Facenet 建议 10.0）
FACE_RECOGNITION_THRESHOLD=10.0

# ============================================================
# 生成强随机密钥的方法：
#
# Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
#
# ============================================================
